{
  "compilerOptions": {
    // esbuild does the emit; tsc is only ever used as a type checker here.
    "noEmit": true,

    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",

    // TypeScript 6 no longer pulls in every package under node_modules/@types
    // implicitly, so the Node globals (`process`, `node:*` modules) have to be
    // requested by name.
    "types": ["node"],

    // Set here rather than only in the webview project so a stray .tsx under
    // src/ is a type error rather than a parse error.
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // `src/webview` is its own project: it needs the DOM lib and bundler module
  // resolution, and the extension host must not get either. See
  // src/webview/tsconfig.json.
  "exclude": ["node_modules", "dist", "out", "src/webview"]
}
